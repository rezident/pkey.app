{
    "name": "pkey.app",
    "private": false,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx}": [
            "eslint"
        ],
        "src/**/*.css": [
            "stylelint"
        ],
        "**/*.{js,jsx,ts,tsx,css,md,html,json}": [
            "prettier --check"
        ]
    },
    "license": "AGPL-3.0",
    "dependencies": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vite": "^8.0.16"
    }
}
